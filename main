-- Drawings for the mana overlay
local spellvis = Drawing.new("Square")
spellvis.Filled       = true
spellvis.Color        = Color3.fromRGB(100, 180, 255)
spellvis.Transparency = 0.5
spellvis.Visible      = false
spellvis.ZIndex       = 20

local snapvis = Drawing.new("Square")
snapvis.Filled       = true
snapvis.Color        = Color3.fromRGB(255, 220, 80)
snapvis.Transparency = 0.5
snapvis.Visible      = false
snapvis.ZIndex       = 21

local currentEquippedTool = nil

local function getScholarBoost()
    local boost = 0
    local char = localPlayer and localPlayer.Character
    if char then
        local boosts = char:FindFirstChild("Boosts")
        if boosts then
            local sb = boosts:FindFirstChild("ScholarsBoon")
            if sb then
                local ok, v = pcall(function() return sb.Value end)
                if ok and v then boost = boost + v end
            end
        end
    end
    local backpack = safeRead(function() return localPlayer:FindFirstChildOfClass("Backpack") end)
    if backpack then
        if backpack:FindFirstChild("WiseCasting")  then boost = boost + 2 end
        if backpack:FindFirstChild("RemTraining")  then boost = boost + 3 end
    end
    return boost
end

local function clearManaOverlay()
    spellvis.Visible = false
    snapvis.Visible  = false
end

local GUI_ABSIZE_X = 260
local GUI_ABSIZE_Y = 264

local function readAbsoluteSize(instance)
    local base = instance.Address
    if not base or base == 0 then return nil, nil end
    local ok1, w = pcall(memory_read, "float", base + GUI_ABSIZE_X)
    local ok2, h = pcall(memory_read, "float", base + GUI_ABSIZE_Y)
    if not ok1 or not ok2 then return nil, nil end
    return w, h
end

local function updateManaOverlay(toolName)
    if not UI.GetValue("mana_overlay") then clearManaOverlay(); return end
    if not toolName then clearManaOverlay(); return end

    local spell = SPELL_COST[toolName]
    if not spell or not spell[1] then clearManaOverlay(); return end

    local gui     = safeRead(function() return localPlayer:FindFirstChild("PlayerGui") end)
    local statGui = gui and safeRead(function() return gui:FindFirstChild("StatGui") end)
    local leftC   = statGui and safeRead(function() return statGui:FindFirstChild("LeftContainer") end)
    local manaBar = leftC and safeRead(function() return leftC:FindFirstChild("Mana") end)
    if not manaBar then clearManaOverlay(); return end

    local ok1, absPos = pcall(function() return manaBar.AbsolutePosition end)
    if not ok1 then clearManaOverlay(); return end

    local barW, barH = readAbsoluteSize(manaBar)
    if not barW or not barH or barH == 0 then clearManaOverlay(); return end

    local scholar    = getScholarBoost()
    local lowerbound = math.max(0,   spell[1][1] - scholar)
    local upperbound = math.min(100, spell[1][2] + scholar)

    local baseX = absPos.X
    local baseY = absPos.Y

    local function getY(percent)
        return baseY + barH * (1 - percent / 100)
    end

    local spellTop    = getY(upperbound)
    local spellBottom = getY(lowerbound)
    spellvis.Position    = Vector2.new(baseX, spellTop)
    spellvis.Size        = Vector2.new(barW, math.abs(spellBottom - spellTop))
    spellvis.Transparency = 0.4
    spellvis.Visible     = true

    if spell[2] then
        local snapLower  = math.max(0,   spell[2][1] - scholar)
        local snapUpper  = math.min(100, spell[2][2] + scholar)
        local snapTop    = getY(snapUpper)
        local snapBottom = getY(snapLower)
        snapvis.Position    = Vector2.new(baseX, snapTop)
        snapvis.Size        = Vector2.new(barW, math.abs(snapBottom - snapTop))
        snapvis.Transparency = 0.4
        snapvis.Visible     = true
    else
        snapvis.Visible = false
    end
end

-- ─────────────────────────────────────────────────────────
--  MEMORY / OFFSETS
-- ─────────────────────────────────────────────────────────
local Offsets = {
    MeshPart_MeshId        = 784,
    ParticleEmitter_Rate   = 584,
    UnionOperation_AssetId = 784,
    Misc_StringLength      = 16,
}
local SPECIALMESH_MESHID_OFFSET = 248

local function applyOffsets(data)
    if not data then return false end
    local O = data.Offsets or data.offsets
    if not O then return false end
    if O.MeshPart        and O.MeshPart.MeshId         then Offsets.MeshPart_MeshId        = O.MeshPart.MeshId        end
    if O.ParticleEmitter and O.ParticleEmitter.Rate     then Offsets.ParticleEmitter_Rate   = O.ParticleEmitter.Rate   end
    if O.UnionOperation  and O.UnionOperation.AssetId   then Offsets.UnionOperation_AssetId = O.UnionOperation.AssetId end
    if O.Misc            and O.Misc.StringLength         then Offsets.Misc_StringLength      = O.Misc.StringLength      end
    return true
end

task.spawn(function()
    local sources = {
        "https://rbxoffsets.com/api/v1/windows/offsets/latest/json",
        "https://raw.githubusercontent.com/yasuogoat3/y4hrware-offsets/main/FFlags.json",
        "https://raw.githubusercontent.com/termx3/OpenMacro-XTernal/main/settings/offsets.json",
    }
    for _, url in next, sources do
        local ok, result = pcall(function() return game:HttpGet(url) end)
        if ok and result and #result > 10 then
            local ok2, data = pcall(function() return HttpService:JSONDecode(result) end)
            if ok2 and data and applyOffsets(data) then
                print(string.format("[RL] offsets from %s | MeshId=%d Rate=%d",
                    url:match("([^/]+%.[^/]+)/") or url,
                    Offsets.MeshPart_MeshId, Offsets.ParticleEmitter_Rate))
                return
            end
        end
    end
    warn("[RL] offset fetch failed — using hardcoded fallbacks")
end)

local function readRobloxString(addr)
    if not addr or addr == 0 then return nil end
    local length = memory_read("uintptr_t", addr + Offsets.Misc_StringLength)
    if not length or length == 0 or length > 512 then return nil end
    local dataPtr = length < 16 and addr or memory_read("uintptr_t", addr)
    if not dataPtr or dataPtr == 0 then return nil end
    local chars = {}
    for i = 0, length - 1 do
        local b = memory_read("byte", dataPtr + i)
        if not b or (b < 32 and b ~= 0) then break end
        chars[#chars + 1] = string.char(b)
    end
    return table.concat(chars)
end

local function parseAssetId(raw)
    if not raw then return nil end
    return raw:match("rbxassetid://(%d+)") or raw:match("^(%d+)$") or nil
end

local function readMeshId(part)
    if not part or part.ClassName ~= "MeshPart" then return nil end
    local base = part.Address
    if not base or base == 0 then return nil end
    return parseAssetId(readRobloxString(base + Offsets.MeshPart_MeshId))
end

local function readSpecialMeshId(mesh)
    if not mesh or mesh.ClassName ~= "SpecialMesh" then return nil end
    local base = mesh.Address
    if not base or base == 0 then return nil end
    return parseAssetId(readRobloxString(base + SPECIALMESH_MESHID_OFFSET))
end

local function readUnionAssetId(union)
    if not union or union.ClassName ~= "UnionOperation" then return nil end
    local base = union.Address
    if not base or base == 0 then return nil end
    local ptr = memory_read("uintptr_t", base + Offsets.UnionOperation_AssetId)
    if not ptr or ptr == 0 then return nil end
    return parseAssetId(readRobloxString(ptr))
end

local function readPERate(pe)
    if not pe then return nil end
    local base = pe.Address
    if not base or base == 0 then return nil end
    local rate = memory_read("float", base + Offsets.ParticleEmitter_Rate)
    if not rate then return nil end
    local r = math.floor(rate + 0.5)
    if r <= 0 or r > 1000 then return nil end
    return r
end

