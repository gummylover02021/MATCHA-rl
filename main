local trinket_colors = {
    common   = { Color = Color3.fromRGB(200, 200, 200), ZIndex = 1 },
    rare     = { Color = Color3.fromRGB(100, 149, 237), ZIndex = 2 },
    mythic   = { Color = Color3.fromRGB(180,  80, 255), ZIndex = 3 },
    artifact = { Color = Color3.fromRGB(255, 165,   0), ZIndex = 4 },
    event    = { Color = Color3.fromRGB( 50, 205,  50), ZIndex = 5 },
    none     = { Color = Color3.fromRGB(160, 160, 160), ZIndex = 0 },
}

local MESH_ID_MAP = {
    ["5196782997"] = { name = "Old Ring",                 rarity = "common"   },
    ["5196776695"] = { name = "Ring",                     rarity = "common"   },
    ["5204003946"] = { name = "Goblet",                   rarity = "common"   },
    ["5196577540"] = { name = "Old Amulet",               rarity = "common"   },
    ["5196551436"] = { name = "Amulet",                   rarity = "common"   },
    ["5204453430"] = { name = "Scroll",                   rarity = "rare"     },
    ["5197099782"] = { name = "Amulet of the White King", rarity = "artifact" },
    ["5196963069"] = { name = "Lannis Amulet",            rarity = "artifact" },
    ["4103271893"] = { name = "Candy",                    rarity = "event"    },
    ["2520762076"] = { name = "Howler Friend",            rarity = "artifact" },
    ["2877143560"] = { name = "Gem",                      rarity = "rare"     },
    ["4027112893"] = { name = "Bound Book",               rarity = "rare"     },
}

local rarityByColor = {}
for k, v in next, trinket_colors do
    rarityByColor[v.Color] = k:sub(1,1):upper() .. k:sub(2)
end
local function colorToRarity(c) return rarityByColor[c] end

local function identify_trinket(v)
    local cls = safeRead(function() return v.ClassName end)
    if not cls then return nil end

    if cls == "MeshPart" then
        local mid = readMeshId(v)
        if mid then
            local entry = MESH_ID_MAP[mid]
            if entry then
                local col = trinket_colors[entry.rarity]
                return entry.name, col.Color, col.ZIndex
            end
        end
        local hasMeshChildren, meshChildCount = false, 0
        local hasDirectPE, hasAttachment, hasWeld = false, false, false
        for _, c in next, v:GetChildren() do
            if c.ClassName == "MeshPart"  then meshChildCount = meshChildCount + 1; hasMeshChildren = true end
            if c.ClassName == "ParticleEmitter" then hasDirectPE = true end
            if c.Name      == "Attachment"      then hasAttachment = true end
        end
        hasWeld = v:FindFirstChildOfClass("Weld") ~= nil
        local hasPointLight = v:FindFirstChildOfClass("PointLight") ~= nil
        if hasMeshChildren then
            if hasWeld and meshChildCount >= 2                      then return "Scroll",           trinket_colors.rare.Color,     trinket_colors.rare.ZIndex
            elseif hasWeld and meshChildCount == 1 and hasPointLight then return "Lannis Amulet",   trinket_colors.artifact.Color, trinket_colors.artifact.ZIndex
            elseif hasWeld and meshChildCount == 1                   then return "Amulet (Artifact)",trinket_colors.artifact.Color, trinket_colors.artifact.ZIndex
            elseif meshChildCount >= 2                               then return "Amulet (Artifact)",trinket_colors.artifact.Color, trinket_colors.artifact.ZIndex
            else                                                          return "Amulet",           trinket_colors.common.Color,   trinket_colors.common.ZIndex
            end
        end
        if hasAttachment and hasDirectPE  then return "Amulet", trinket_colors.common.Color, trinket_colors.common.ZIndex end
        if hasAttachment and not hasDirectPE then return "Scroll", trinket_colors.rare.Color, trinket_colors.rare.ZIndex end
        return "Trinket", trinket_colors.common.Color, trinket_colors.common.ZIndex
    end

    if cls == "Part" then
        local hasSM  = v:FindFirstChildOfClass("SpecialMesh") ~= nil
        local hasOrb = v:FindFirstChild("OrbParticle") ~= nil
        local hasAtt = v:FindFirstChild("Attachment") ~= nil
        local directPE = v:FindFirstChildOfClass("ParticleEmitter")
        if hasSM and hasOrb  then return "???",        trinket_colors.rare.Color,   trinket_colors.rare.ZIndex end
        if hasOrb and not hasSM then return "Ice Essence", trinket_colors.rare.Color, trinket_colors.rare.ZIndex end
        if hasSM and not hasOrb then
            local sm   = v:FindFirstChildOfClass("SpecialMesh")
            local smId = sm and readSpecialMeshId(sm)
            if smId == "2877143560" then return "Gem",  trinket_colors.rare.Color, trinket_colors.rare.ZIndex
            else                         return "Opal", trinket_colors.rare.Color, trinket_colors.rare.ZIndex end
        end
        if hasAtt then
            local att = v:FindFirstChild("Attachment")
            local pe  = att and att:FindFirstChildOfClass("ParticleEmitter")
            if pe then
                local rate = readPERate(pe)
                if rate == 3 then return "Mysterious Artifact",      trinket_colors.mythic.Color,   trinket_colors.mythic.ZIndex
                elseif rate == 5 then
                    return (game.PlaceId == 3541987450) and "Phoenix Flower" or "Phoenix Down / Azael Horn",
                           trinket_colors.artifact.Color, trinket_colors.artifact.ZIndex
                end
            end
            if att and att:FindFirstChild("swirl") then return "Idol of War", trinket_colors.common.Color, trinket_colors.common.ZIndex end
        end
        if directPE and not hasSM then return "Rift Gem", trinket_colors.mythic.Color, trinket_colors.mythic.ZIndex end
    end

    if cls == "UnionOperation" then
        local aid = readUnionAssetId(v)
        return "Idol", trinket_colors.common.Color, trinket_colors.common.ZIndex
    end
    return nil
end

local trinket_esp_objects = {}

local function detectTrinketArea(trinket)
    local areaMarkers = ws:FindFirstChild("AreaMarkers")
    if not areaMarkers then return "None" end
    local pos = safeRead(function() return trinket.Position end)
    if not pos then return "None" end
    local best, bestD = "None", math.huge
    for _, m in next, areaMarkers:GetChildren() do
        local mp = safeRead(function() return m.Position end)
        if mp then local d = (pos - mp).Magnitude; if d < bestD then best = m.Name; bestD = d end end
    end
    return best
end

local function add_trinket_esp(trinket, name, color, zindex)
    local zi = zindex or 10
    local dot = Drawing.new("Circle"); dot.Radius=4; dot.NumSides=12; dot.Filled=true; dot.Color=color; dot.ZIndex=zi; dot.Visible=false
    local dotO = Drawing.new("Circle"); dotO.Radius=5; dotO.NumSides=12; dotO.Filled=false; dotO.Thickness=1; dotO.Color=Color3.fromRGB(0,0,0); dotO.ZIndex=zi-1; dotO.Visible=false
    local line = Drawing.new("Line"); line.Thickness=1; line.Color=color; line.ZIndex=zi; line.Visible=false
    local lbl = Drawing.new("Text"); lbl.Center=true; lbl.Outline=true; lbl.Font=Drawing.Fonts.SystemBold; lbl.Size=13; lbl.Color=color; lbl.ZIndex=zi+1; lbl.Visible=false

    local esp = { object=trinket, name=name, color=color, area=detectTrinketArea(trinket), disabled=false, lastText="", lastTextTime=0, dot=dot, dotOutline=dotO, line=line, label=lbl }

    function esp:hide()
        self.dot.Visible=false; self.dotOutline.Visible=false; self.line.Visible=false; self.label.Visible=false; self.disabled=true
    end
    function esp:destruct()
        self.dot:Remove(); self.dotOutline:Remove(); self.line:Remove(); self.label:Remove()
        trinket_esp_objects[self.object.Address]=nil; trinket_esp_objects[self.object]=nil
    end
    function esp:update(toggled, range, showArea)
        if not toggled then if not self.disabled then self:hide() end return end
        local rarity  = colorToRarity(self.color)
        self.disabled = false
        if safeRead(function() return self.object.Parent end) == nil then self:destruct() return end
        local pos = safeRead(function() return self.object.CFrame.Position end)
        if not pos then self:hide() return end
        local cam = ws.CurrentCamera
        if not cam then self:hide() return end
        local dist = (cam.CFrame.Position - pos).Magnitude
        if dist >= range then self:hide() return end
        local sp, on = WorldToScreen(pos)
        if not on then self:hide() return end
        local now = os.clock()
        if now - self.lastTextTime >= 0.2 then
            local aStr = (showArea and self.area ~= "None") and "\n("..self.area..")" or ""
            self.lastText = self.name.."\n"..math.floor(dist).."m"..aStr
            self.lastTextTime = now
        end
        local dp = Vector2.new(sp.X, sp.Y)
        local lp = Vector2.new(sp.X, sp.Y - 28)
        self.dot.Position=dp; self.dot.Visible=true
        self.dotOutline.Position=dp; self.dotOutline.Visible=true
        self.line.From=dp; self.line.To=lp; self.line.Visible=true
        self.label.Text=self.lastText; self.label.Position=lp; self.label.Visible=true
    end

    trinket_esp_objects[trinket.Address] = esp
    trinket_esp_objects[trinket]          = esp
    return esp
end

local TRINKET_SCAN_INTERVAL = 2
task.spawn(function()
    while true do
        task.wait(TRINKET_SCAN_INTERVAL)
        if UI.GetValue("trinket_esp") then
            local char = localPlayer and localPlayer.Character
            local root = char and getRootPart(char)
            if root then
                local rootPos = root.Position
                local range   = UI.GetValue("trinket_range") or 75
                pcall(function()
                    for _, v in next, ws:GetChildren() do
                        if (v:IsA("BasePart") or v:IsA("UnionOperation"))
                        and v.Name == "Part"
                        and v:FindFirstChild("ID")
                        and not trinket_esp_objects[v.Address]
                        and (v.Position - rootPos).Magnitude <= range + 20 then
                            local name, color, zindex = identify_trinket(v)
                            if name then
                                print("[TrinketESP] found: " .. name)
                                add_trinket_esp(v, name, color, zindex)
                            end
                        end
                    end
                end)
            end
        end
    end
end)



