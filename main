-- ═════════════════════════════════════════════════════════
--  MAIN LOOPS
-- ═════════════════════════════════════════════════════════
RunService.RenderStepped:Connect(function(dt)
  -- ── Mana Overlay ─────────────────────────────────────
    if UI.GetValue("mana_overlay") then
        local char = localPlayer and localPlayer.Character
        if char then
            local tool = safeRead(function()
                for _, v in next, char:GetChildren() do
                    if v.ClassName == "Tool" then return v end
                end
                return nil
            end)
            local toolName = tool and safeRead(function() return tool.Name end)
            if toolName ~= currentEquippedTool then
                currentEquippedTool = toolName
            end
            updateManaOverlay(currentEquippedTool)
        else
            clearManaOverlay()
        end
    else
        clearManaOverlay()
        currentEquippedTool = nil
    end

    -- ── Trinket ESP updates ──────────────────────────────
    local trinketOn  = UI.GetValue("trinket_esp")
    local trinketRng = UI.GetValue("trinket_range") or 75
    local showArea   = UI.GetValue("trinket_show_area")
    for _, esp in next, trinket_esp_objects do
        if type(esp) == "table" and esp.update then
            pcall(function() esp:update(trinketOn, trinketRng, showArea) end)
        end
    end

    -- ── Bane TP ──────────────────────────────────────────
    if UI.GetValue("bane_tp") then
        local baneRadius = UI.GetValue("bane_radius") or 15
        local attackNow  = isAttacking()
        if attackNow and not wasAttacking and not interpActive and hasBaneEff() then
            local myRoot = getLocalRootPart()
            if myRoot then
                local myChar  = myRoot.Parent
                local myPos   = myRoot.Position
                local charSet = getPlayerCharSet()
                local target  = getLookedAtHRP(myChar, baneRadius)
                if target and (target.Position - myPos).Magnitude > baneRadius then target = nil end
                target = target or findNearestHRP(myChar, myPos, charSet, baneRadius)
                if target then
                    local ok, cf = pcall(buildGoalCFrame, target, myRoot)
                    if ok and cf then
                        interpGoal = cf; interpActive = true; interpTimer = 0
                        interpName = safeRead(function() return target.Parent.Name end) or "?"
                    end
                end
            end
        end
        wasAttacking = attackNow

        if interpActive and interpGoal then
            interpTimer = interpTimer + dt
            if interpTimer > 0.2 or isRagdolled() then
                interpActive = false; interpGoal = nil; interpTimer = 0
            else
                local myRoot = getLocalRootPart()
                if myRoot then
                    local current = myRoot.CFrame
                    local dist    = (current.Position - interpGoal.Position).Magnitude
                    if dist < DONE_DIST then
                        pcall(function() myRoot.CFrame = interpGoal; myRoot.AssemblyLinearVelocity=Vector3.zero; myRoot.AssemblyAngularVelocity=Vector3.zero end)
                        interpActive = false; interpGoal = nil; interpTimer = 0
                    else
                        local speedScale = math.clamp(dist/5, 0.4, 1)
                        local alpha      = math.clamp(LERP_SPEED * speedScale * dt, 0, 1)
                        pcall(function() myRoot.CFrame = current:Lerp(interpGoal, alpha); myRoot.AssemblyLinearVelocity = myRoot.AssemblyLinearVelocity * 0.3 end)
                    end
                else
                    interpActive = false; interpGoal = nil; interpTimer = 0
                end
            end
        end
    else
        wasAttacking = false
        if interpActive then interpActive=false; interpGoal=nil; interpTimer=0 end
    end

    -- ── Grapple correction ───────────────────────────────
    if UI.GetValue("grapple_correction") and grappleActive then
        if not grappleTarget then grappleTarget = findGrappleTarget() end
        if grappleTarget then
            local localChar = localPlayer.Character
            if not localChar then onGrappleEnd()
            else
                local hrp = localChar:FindFirstChild("HumanoidRootPart")
                if not hrp then onGrappleEnd()
                else
                    local bv = hrp:FindFirstChild("GrappleVelocity")
                    if not bv then onGrappleEnd()
                    else
                        local targetRoot = getRootPart(grappleTarget)
                        if targetRoot then
                            local myPos, targetPos = hrp.Position, targetRoot.Position
                            local yDelta = targetPos.Y - myPos.Y
                            if math.abs(yDelta) <= MAX_Y_DELTA then
                                local ok, curVel = pcall(function() return bv.Velocity end)
                                if ok and curVel then
                                    local hDist  = Vector3.new(targetPos.X-myPos.X, 0, targetPos.Z-myPos.Z).Magnitude
                                    local hSpeed = math.sqrt(curVel.X^2 + curVel.Z^2)
                                    if hSpeed >= 1 then
                                        local travelTime = hDist / hSpeed
                                        local neededYVel = math.clamp((targetPos.Y-myPos.Y)/travelTime + (0.5*196.2*travelTime), -200, 200)
                                        local blendedY   = curVel.Y + (neededYVel - curVel.Y) * CORRECTION_STRENGTH
                                        pcall(function() bv.Velocity = Vector3.new(curVel.X, blendedY, curVel.Z) end)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local now = tick()

    -- ── Grapple watcher ──────────────────────────────────
    if UI.GetValue("grapple_correction") then
        local localChar = localPlayer.Character
        if localChar then
            if localChar ~= localChar_last then
                localChar_last = localChar; localSnapshot = buildSnapshot(localChar)
            else
                diffAndDetect(localChar, localSnapshot, "LOCAL")
            end
        end
        if now - lastNearestCheck >= NEAREST_INTERVAL then
            lastNearestCheck = now
            local newNearest, newChar = getNearestChar()
            if newNearest ~= lastNearestPlayer or newChar ~= lastNearestChar then
                lastNearestPlayer = newNearest; lastNearestChar = newChar
                nearestSnapshot = (newNearest and newChar) and buildSnapshot(newChar) or {}
            end
        end
        if lastNearestChar and lastNearestPlayer then
            local ok, parent = pcall(function() return lastNearestChar.Parent end)
            if ok and parent then diffAndDetect(lastNearestChar, nearestSnapshot, "NEAREST")
            else lastNearestChar = nil; nearestSnapshot = {} end
        end
    end

    -- ── Notification expiry ───────────────────────────────
    for i = #notifications, 1, -1 do
        local notif = notifications[i]
        if notif.removing then continue end
        if tick() - notif.createdAt >= notif.duration and not notif.tweening then
            table.remove(notifications, i)
            removeNotification(notif, function() repositionNotifications() end)
        end
    end
-- ── Illusionist Detector ───────────────────
    if UI.GetValue("illusionist_detector") then
        for _, player in ipairs(Players:GetPlayers()) do
            local pid = safeRead(function() return player.UserId end)
            if pid and pid ~= localPlayer.UserId and not illusionistList[pid] then
                -- mark as pending so we don't spawn twice
                illusionistList[pid] = { name = safeRead(function() return player.Name end) or "?", alerted = false, pending = true }
                watchIllusionist(player)
            end
        end
    end

    -- ── Group detector player tracking ───────────────────
    if UI.GetValue("group_detector") then
        local newCurrentPlayers = {}
        for _, player in ipairs(Players:GetPlayers()) do
            newCurrentPlayers[player.UserId] = player
            if not currentPlayers[player.UserId] and trackedPlayers[player.UserId] == nil then
                trackedPlayers[player.UserId] = false
                onPlayerJoined(player, false)
            end
        end
        for userId, _ in pairs(currentPlayers) do
            if not newCurrentPlayers[userId] then
                trackedPlayers[userId] = nil
                if groupMembersInServer[userId] then
                    onPlayerLeft(userId, groupMembersInServer[userId])
                end
            end
        end
        currentPlayers = newCurrentPlayers
    end

    -- ── Spawn tracker update ─────────────────────────────
    if UI.GetValue("spawn_tracker") then
        local nowClock = os.clock()
        if nowClock - spawnLastUpdate >= 5 then
            spawnLastUpdate = nowClock
            pcall(updateSpawnLabels)
        end
    end
end)

print("[Rogue Lineage] Loaded — UI tab active")
