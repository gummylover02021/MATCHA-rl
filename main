local STAND_OFFSET = 2
local LERP_SPEED   = 14
local DONE_DIST    = 0.8
local interpActive = false
local interpTimer  = 0
local interpGoal   = nil
local interpName   = "?"
local wasAttacking = false

local function hasBaneEff()
    local char = localPlayer and localPlayer.Character
    if not char then return false end
    for _, v in next, char:GetChildren() do
        if v.ClassName == "Accessory" and v.Name == "BaneEff" then return true end
    end
    return false
end

local function isAttacking()
    local char = localPlayer and localPlayer.Character
    if not char then return false end
    for _, v in next, char:GetChildren() do
        if v.ClassName == "Accessory" and v.Name == "LightAttack" then return true end
    end
    return false
end

local function isRagdolled()
    if not localPlayer then return false end
    local char = localPlayer.Character
    if not char then return false end
    local ok, result = pcall(function() return char:FindFirstChild("Stun") ~= nil end)
    return ok and result or false
end

local function getLocalRootPart()
    local char = localPlayer and localPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getPlayerCharSet()
    local set = {}
    for _, p in next, Players:GetPlayers() do
        local c = safeRead(function() return p.Character end)
        if c then set[c] = true end
    end
    return set
end

local function getRootModelHRP(instance, myChar)
    if not instance then return nil end
    local obj = instance
    while obj and obj.Parent ~= ws do obj = obj.Parent end
    if not obj or obj == myChar then return nil end
    local hrp = safeRead(function() return obj:FindFirstChild("HumanoidRootPart") end)
    local hum = safeRead(function() return obj:FindFirstChildOfClass("Humanoid") end)
    return (hrp and hum) and hrp or nil
end

local function getLookedAtHRP(myChar, radius)
    local cam = ws.CurrentCamera
    if not cam then return nil end
    local result = safeRead(function() return ws:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * radius) end)
    return result and getRootModelHRP(result.Instance, myChar) or nil
end

local function findNearestHRP(myChar, myPos, charSet, radius)
    local bestDist, bestHRP = radius, nil
    for _, p in next, Players:GetPlayers() do
        if p == localPlayer then continue end
        local char = safeRead(function() return p.Character end)
        if not char then continue end
        local hrp = safeRead(function() return char:FindFirstChild("HumanoidRootPart") end)
        if not hrp then continue end
        local d = (hrp.Position - myPos).Magnitude
        if d < bestDist then bestDist = d; bestHRP = hrp end
    end
    for _, obj in next, ws:GetChildren() do
        if charSet[obj] or obj == myChar then continue end
        local ok, children = pcall(function() return obj:GetChildren() end)
        if not ok then continue end
        local hrp, hasHum = nil, false
        for _, child in next, children do
            local cn = safeRead(function() return child.ClassName end)
            if cn == "Humanoid"         then hasHum = true end
            if cn == "HumanoidRootPart" then hrp = child   end
        end
        if hasHum and hrp then
            local d = (hrp.Position - myPos).Magnitude
            if d < bestDist then bestDist = d; bestHRP = hrp end
        end
    end
    return bestHRP
end

local function buildGoalCFrame(hrp, myRoot)
    local myPos, targetPos = myRoot.Position, hrp.Position
    local toMe = myPos - targetPos
    local mag  = toMe.Magnitude
    local dir  = mag > 0.01 and toMe.Unit or Vector3.new(0,0,1)
    local landPos = targetPos + dir * STAND_OFFSET
    local fwd = targetPos - landPos
    local fwdM = fwd.Magnitude
    fwd = fwdM > 0.01 and fwd.Unit or Vector3.new(0,0,-1)
    local worldUp = Vector3.new(0,1,0)
    local right = fwd:Cross(worldUp)
    local rightM = right.Magnitude
    right = rightM > 0.01 and right.Unit or Vector3.new(1,0,0)
    local up = right:Cross(fwd)
    return CFrame.new(landPos.X,landPos.Y,landPos.Z, right.X,right.Y,right.Z, up.X,up.Y,up.Z, -fwd.X,-fwd.Y,-fwd.Z)
end

-- ═════════════════════════════════════════════════════════
--  GRAPPLE CORRECTION
-- ═════════════════════════════════════════════════════════
local grappleActive   = false
local grappleTarget   = nil
local grappleVelocity = nil
local CORRECTION_STRENGTH = 0.75
local MAX_Y_DELTA         = 80

local function findGrappleTarget()
    for _, p in next, Players:GetPlayers() do
        if p == localPlayer then continue end
        local char = p.Character
        if char and char:FindFirstChild("GrapplePulled") then return char end
    end
    return nil
end

local function onGrappleStart(bv)
    grappleActive = true; grappleVelocity = bv; grappleTarget = findGrappleTarget()
end
local function onGrappleEnd()
    grappleActive = false; grappleVelocity = nil; grappleTarget = nil
end

-- Descendant watcher for grapple detection
local localSnapshot     = {}
local nearestSnapshot   = {}
local lastNearestPlayer = nil
local lastNearestChar   = nil
local localChar_last    = nil

local function buildSnapshot(model)
    local snap = {}
    local ok, descendants = pcall(function() return model:GetDescendants() end)
    if ok and descendants then
        for _, d in next, descendants do
            local ok2, addr = pcall(function() return d.Address end)
            if ok2 and addr then snap[addr] = true end
        end
    end
    return snap
end

local function diffAndDetect(model, snapshot, label)
    local ok, descendants = pcall(function() return model:GetDescendants() end)
    if not ok or not descendants then return end
    for _, d in next, descendants do
        local ok2, addr = pcall(function() return d.Address end)
        if not ok2 or not addr then continue end
        if not snapshot[addr] then
            snapshot[addr] = true
            if label == "LOCAL" then
                local ok3, name = pcall(function() return d.Name end)
                local ok4, cls  = pcall(function() return d.ClassName end)
                if ok3 and ok4 and name == "GrappleVelocity" and cls == "BodyVelocity" then
                    onGrappleStart(d)
                end
            end
        end
    end
end

local function getNearestChar()
    local localChar = localPlayer.Character
    local localRoot = getRootPart(localChar)
    if not localRoot then return nil, nil end
    local nearestPlayer, nearestDist = nil, math.huge
    for _, p in next, Players:GetPlayers() do
        if p == localPlayer then continue end
        local char = p.Character
        local root = getRootPart(char)
        if root then
            local dist = (root.Position - localRoot.Position).Magnitude
            if dist < nearestDist then nearestDist = dist; nearestPlayer = p end
        end
    end
    if nearestPlayer then return nearestPlayer, nearestPlayer.Character end
    return nil, nil
end

local initChar = localPlayer.Character
if initChar then localChar_last = initChar; localSnapshot = buildSnapshot(initChar) end
local initNearest, initNearestChar = getNearestChar()
if initNearest and initNearestChar then
    lastNearestPlayer = initNearest; lastNearestChar = initNearestChar
    nearestSnapshot = buildSnapshot(initNearestChar)
end

local NEAREST_INTERVAL = 2
local lastNearestCheck = 0

-- ═════════════════════════════════════════════════════════
--  GROUP DETECTOR
-- ═════════════════════════════════════════════════════════
local GROUP_ID              = 4556484
local groupMembersInServer  = {}
local trackedPlayers        = {}
local currentPlayers        = {}
local notifications         = {}

local NOTIF_WIDTH   = 320
local NOTIF_HEIGHT  = 60
local NOTIF_X       = 20
local NOTIF_Y       = 80
local NOTIF_GAP     = 8
local OFFSCREEN_X   = -NOTIF_WIDTH - 20
local DEFAULT_DUR   = 5
local EXISTING_DUR  = 12

local drawingMeta = {}
local function setMeta(d, ox) drawingMeta[d] = { offsetX = ox } end
local function getOffsetX(d) local m = drawingMeta[d]; return m and m.offsetX or 0 end
local function cleanMeta(d) drawingMeta[d] = nil end

local function tweenDrawingsX(notif, fromX, toX, dur, onComplete)
    local startTime = tick()
    local con
    con = RunService.Heartbeat:Connect(function()
        local t = math.min((tick() - startTime) / dur, 1)
        local eased = 1 - (1 - t)^3
        local cx = fromX + (toX - fromX) * eased
        for _, d in ipairs(notif.drawings) do
            local ox = getOffsetX(d)
            pcall(function() d.Position = Vector2.new(cx + ox, d.Position.Y) end)
        end
        if t >= 1 then con:Disconnect(); if onComplete then onComplete() end end
    end)
    return con
end

local function repositionNotifications()
    local y = NOTIF_Y
    for _, notif in ipairs(notifications) do
        local bg, accent, title, body = notif.drawings[1], notif.drawings[2], notif.drawings[3], notif.drawings[4]
        bg.Position    = Vector2.new(bg.Position.X,    y)
        accent.Position= Vector2.new(accent.Position.X,y)
        title.Position = Vector2.new(title.Position.X, y + 10)
        body.Position  = Vector2.new(body.Position.X,  y + 32)
        y = y + NOTIF_HEIGHT + NOTIF_GAP
    end
end

local function createNotification(title, body, color, duration)
    local notif = { title=title, body=body, color=color or Color3.fromRGB(60,120,255),
                    createdAt=tick(), duration=duration or DEFAULT_DUR, drawings={}, tweening=true, removing=false }
    local startY = NOTIF_Y

    local bg = Drawing.new("Square")
    bg.Size=Vector2.new(NOTIF_WIDTH,NOTIF_HEIGHT); bg.Position=Vector2.new(OFFSCREEN_X,startY)
    bg.Color=Color3.fromRGB(20,20,28); bg.Filled=true; bg.Transparency=1; bg.Visible=true; bg.ZIndex=10; bg.Corner=8
    setMeta(bg, 0)

    local accent = Drawing.new("Square")
    accent.Size=Vector2.new(4,NOTIF_HEIGHT); accent.Position=Vector2.new(OFFSCREEN_X,startY)
    accent.Color=notif.color; accent.Filled=true; accent.Transparency=1; accent.Visible=true; accent.ZIndex=11
    setMeta(accent, 0)

    local titleText = Drawing.new("Text")
    titleText.Text=title; titleText.Position=Vector2.new(OFFSCREEN_X+14,startY+10)
    titleText.Color=notif.color; titleText.Size=16; titleText.Font=Drawing.Fonts.SystemBold
    titleText.Outline=true; titleText.Visible=true; titleText.ZIndex=12
    setMeta(titleText, 14)

    local bodyText = Drawing.new("Text")
    bodyText.Text=body; bodyText.Position=Vector2.new(OFFSCREEN_X+14,startY+32)
    bodyText.Color=Color3.fromRGB(210,210,220); bodyText.Size=13; bodyText.Font=Drawing.Fonts.System
    bodyText.Outline=true; bodyText.Visible=true; bodyText.ZIndex=12
    setMeta(bodyText, 14)

    notif.drawings = { bg, accent, titleText, bodyText }
    table.insert(notifications, notif)
    repositionNotifications()
    tweenDrawingsX(notif, OFFSCREEN_X, NOTIF_X, 0.35, function() notif.tweening = false end)
    return notif
end

local function removeNotification(notif, onDone)
    if notif.removing then return end
    notif.removing = true
    tweenDrawingsX(notif, NOTIF_X, OFFSCREEN_X, 0.3, function()
        for _, d in ipairs(notif.drawings) do cleanMeta(d); d:Remove() end
        if onDone then onDone() end
    end)
end

local function isInGroup(player)
    local url = string.format("https://groups.roblox.com/v2/users/%d/groups/roles", player.UserId)
    local body = httpget(url)
    if body == "" then return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok or not data or not data.data then return false end
    for _, entry in ipairs(data.data) do
        if entry.group and entry.group.id == GROUP_ID then
            return true, entry.role and entry.role.name or "Unknown Rank"
        end
    end
    return false
end

local function onPlayerJoined(player, isExisting)
    task.spawn(function()
        local inGroup, rank = isInGroup(player)
        if inGroup then
            if not UI.GetValue("group_detector") then return end
            groupMembersInServer[player.UserId] = { name=player.Name, rank=rank }
            if isExisting then
                createNotification("Group Member In Server", player.Name.." | "..(rank or "N/A"), Color3.fromRGB(255,180,0), EXISTING_DUR)
            else
                createNotification("Group Member Joined", player.Name.." | "..(rank or "N/A"), Color3.fromRGB(80,220,120))
            end
            repositionNotifications()
        end
        trackedPlayers[player.UserId] = true
    end)
end

local function onPlayerLeft(userId, data)
  if not UI.GetValue("group_detector") then return end
    createNotification("Group Member Left", data.name.." | "..(data.rank or "N/A"), Color3.fromRGB(220,80,80))
    groupMembersInServer[userId] = nil
    repositionNotifications()
end

local existing = Players:GetPlayers()
for _, player in ipairs(existing) do
    currentPlayers[player.UserId] = player
    onPlayerJoined(player, true)
end

-- ═════════════════════════════════════════════════════════
--  MONSTER SPAWN TRACKER
-- ═════════════════════════════════════════════════════════
local spawnTrackerEnabled = false
local spawnPanel, spawnBorder, spawnHeader, spawnDivider = nil, nil, nil, nil
local spawnRowLabels = {}
local spawnLocations = nil
local spawnLastUpdate = 0

local function buildSpawnTracker()
    local ok = pcall(function()
        local triggers = ws.MonsterSpawns.Triggers
        spawnLocations = {
            { name = "Crypt",          value = triggers.CryptTrigger.LastSpawned    },
            { name = "Castle Rock",    value = triggers.CastleRockSnake.LastSpawned },
            { name = "Snake Pit",      value = triggers.MazeSnakes.LastSpawned      },
            { name = "Sunken Passage", value = triggers.evileye1.LastSpawned        },
        }
    end)
    if not ok then warn("[SpawnTracker] MonsterSpawns not found"); return false end

    local C_BG    = Color3.fromRGB(10, 11, 14)
    local C_BDR   = Color3.fromRGB(50, 55, 72)
    local C_HEAD  = Color3.fromRGB(158,158,232)
    local ROW_H   = 20
    local PAD     = 10
    local WIDTH   = 230
    local HEIGHT  = PAD*2 + 16 + 4 + (#spawnLocations * ROW_H) + PAD
    local PX, PY  = 20, 20

    spawnPanel = Drawing.new("Square"); spawnPanel.Filled=true; spawnPanel.Color=C_BG; spawnPanel.ZIndex=0; spawnPanel.Corner=6
    spawnPanel.Position=Vector2.new(PX,PY); spawnPanel.Size=Vector2.new(WIDTH,HEIGHT); spawnPanel.Visible=false

    spawnBorder = Drawing.new("Square"); spawnBorder.Filled=false; spawnBorder.Color=C_BDR; spawnBorder.ZIndex=1; spawnBorder.Corner=6; spawnBorder.Thickness=1
    spawnBorder.Position=Vector2.new(PX,PY); spawnBorder.Size=Vector2.new(WIDTH,HEIGHT); spawnBorder.Visible=false

    spawnHeader = Drawing.new("Text"); spawnHeader.Text="Monster Spawn Tracker"; spawnHeader.Size=13
    spawnHeader.Font=Drawing.Fonts.SystemBold; spawnHeader.Color=C_HEAD; spawnHeader.Center=true
    spawnHeader.Outline=true; spawnHeader.ZIndex=2; spawnHeader.Visible=false
    spawnHeader.Position=Vector2.new(PX + WIDTH/2, PY + PAD)

    local divY = PY + PAD + 16 + 2
    spawnDivider = Drawing.new("Line"); spawnDivider.Color=C_BDR; spawnDivider.Thickness=1; spawnDivider.ZIndex=2; spawnDivider.Visible=false
    spawnDivider.From=Vector2.new(PX+PAD, divY); spawnDivider.To=Vector2.new(PX+WIDTH-PAD, divY)

    spawnRowLabels = {}
    for i = 1, #spawnLocations do
        local rowY = divY + 4 + (i-1)*ROW_H + (ROW_H-13)/2
        local lbl = Drawing.new("Text"); lbl.Text=spawnLocations[i].name.." - ..."
        lbl.Size=12; lbl.Font=Drawing.Fonts.SystemBold; lbl.Color=Color3.fromRGB(120,125,145)
        lbl.Outline=true; lbl.ZIndex=3; lbl.Visible=false
        lbl.Position=Vector2.new(PX+PAD, rowY)
        spawnRowLabels[i] = lbl
    end
    return true
end

local function setSpawnVisible(v)
    if spawnPanel  then spawnPanel.Visible=v  end
    if spawnBorder then spawnBorder.Visible=v end
    if spawnHeader then spawnHeader.Visible=v end
    if spawnDivider then spawnDivider.Visible=v end
    for _, l in next, spawnRowLabels do l.Visible=v end
end

local function formatSpawnTime(diff)
    local days    = math.floor(diff/86400)
    local hours   = math.floor((diff%86400)/3600)
    local minutes = math.floor((diff%3600)/60)
    local secs    = math.floor(diff%60)
    local parts   = {}
    if days    > 0 then table.insert(parts, days.."d")    end
    if hours   > 0 then table.insert(parts, hours.."h")   end
    if minutes > 0 then table.insert(parts, minutes.."m") end
    if days==0 and hours==0 and minutes==0 and secs>0 then table.insert(parts, secs.."s") end
    return #parts == 0 and "just now" or table.concat(parts, " ")
end

local function updateSpawnLabels()
    if not spawnLocations then return end
    local now = os.time()
    for i, loc in next, spawnLocations do
        local lbl = spawnRowLabels[i]
        if not lbl then continue end
        local ok, raw = pcall(function() return loc.value.Value end)
        if not ok or not raw then
            lbl.Text=loc.name.." - unknown"; lbl.Color=Color3.fromRGB(120,125,145)
        elseif raw == 0 then
            lbl.Text=loc.name.." - never"; lbl.Color=Color3.fromRGB(120,125,145)
        else
            local diff = math.max(0, now - raw)
            local ago  = formatSpawnTime(diff)
            lbl.Text  = loc.name.." - "..ago.." ago"
            lbl.Color = diff < 300 and Color3.fromRGB(220,140,145)
                     or diff < 1800 and Color3.fromRGB(238,185,128)
                     or Color3.fromRGB(228,230,240)
        end
    end
end

-- ═════════════════════════════════════════════════════════
--  ILLUSIONIST DETECTOR
-- ═════════════════════════════════════════════════════════
local illusionistList = {}  -- userId -> { name, hasObserve }

local function checkIllusionist(player)
    local ok, userId = pcall(function() return player.UserId end)
    if not ok or not userId then return end
    if illusionistList[userId] then return end  -- already tracked

    local ok2, name = pcall(function() return player.Name end)
    if not ok2 or not name then return end

    -- Check backpack for Observe tool
    local backpack = safeRead(function() return player:FindFirstChildOfClass("Backpack") end)
    if not backpack then return end

    local hasObserve = safeRead(function()
        return backpack:FindFirstChild("Observe") ~= nil
    end)

    if hasObserve then
if not UI.GetValue("illusionist_detector") then return end
        illusionistList[userId] = { name = name, alerted = false }
        createNotification(
            "Illusionist Detected",
            name .. " has Observe",
            Color3.fromRGB(180, 80, 255),
            EXISTING_DUR
        )
        print(string.format("[Illusionist] DETECTED: %s has Observe in backpack", name))
    end
end

local function watchIllusionist(player)
    local ok, userId = pcall(function() return player.UserId end)
    if not ok or not userId then return end
    local ok2, name = pcall(function() return player.Name end)
    if not ok2 or not name then return end

    task.spawn(function()
        -- Wait a moment for backpack to populate
        task.wait(2)
        checkIllusionist(player)

        -- Watch their character for Observe being equipped
        while true do
            task.wait(0.5)

            -- Stop watching if player left
            local stillHere = false
            for _, p in next, Players:GetPlayers() do
                local pid = safeRead(function() return p.UserId end)
                if pid == userId then stillHere = true; break end
            end
            if not stillHere then
                illusionistList[userId] = nil
                break
            end

            local char = safeRead(function() return player.Character end)
            if not char then continue end

            -- Check if Observe is equipped (in character, not backpack)
            local equipped = safeRead(function()
                return char:FindFirstChild("Observe") ~= nil
            end)

            local entry = illusionistList[userId]
            if equipped and entry and not entry.alerted then
                entry.alerted = true
                createNotification(
                    "Observe Equipped!",
                    name .. " equipped Observe",
                    Color3.fromRGB(255, 60, 60),
                    DEFAULT_DUR
                )
                print(string.format("[Illusionist] EQUIPPED: %s equipped Observe", name))
            elseif not equipped and entry and entry.alerted then
                -- Reset so we alert again next time they equip
                entry.alerted = false
            end
        end
    end)
end

-- Scan players already in server at startup
for _, player in next, Players:GetPlayers() do
    local pid = safeRead(function() return player.UserId end)
    if pid and pid ~= localPlayer.UserId then
        watchIllusionist(player)
    end
end

